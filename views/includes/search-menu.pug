.search-menu.d-flex.flex-column
    if users && users.length
        each user in users
            a.d-flex.flex-row.align-items-center.search-menu-item.pointer-cursor(href='/users/' + user.username)
                img.p-2(width="40" height="40" src=user.avatar)
                span= user.username
    else
        span.empty-search-menu Aucun utilisateur trouvé