extends ../layout

block content
    div(class="d-flex flex-row content mx-auto")
        div(class="profile-container")
            include ../includes/profile
        div(class="flex-fill")
            form(class="card" method="post" action="/api/tweets")
                .card-header Ecrire un tweet
                .card-body
                    .form-group
                        textarea(class="form-control" name="content" placeholder="What's happening ?")
                    if errors
                        ul.my-2
                            each error in errors
                                li(class="text-danger")= error
                    .w-100
                        input(type="submit" value="Send" class="btn btn-primary ml-auto d-block")