extends ../layout

block content
    div(class="d-flex flex-row content mx-auto")
        div(class="flex-fill")
            form(class="card" method="post" action= tweet._id ? "/tweets/" + tweet._id : "/tweets")
                .card-header Ecrire un tweet
                .card-body
                    .form-group
                        textarea(class="form-control" name="content" placeholder="What's happening ?")= tweet.content
                    if errors
                        ul.my-2
                            each error in errors
                                li(class="text-danger")= error
                    .w-100
                        input.btn.btn-primary.ml-auto.float-right(type="submit" value="Envoyer")
                        a.btn.btn-danger.ml-auto.float-right.mr-1(href="/") Annuler
