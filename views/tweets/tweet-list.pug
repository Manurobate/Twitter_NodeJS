if tweets
    each tweet in tweets
        .card.mb-2
            .card-body
                .row
                    .col-2.text-center
                        a.d-inline-block.text-reset.text-decoration-none(href=`/users/${tweet.author.username}`)
                            img.img-fluid.rounded-circle.tweet-author-avatar.mb-2(src=tweet.author.avatar, alt=`Avatar de ${tweet.author.username}`)
                            .small.text-truncate= tweet.author.username
                    .col-8= tweet.content
                    .col-2.text-end
                        if isAuthenticated && editable && tweet.author._id.toString() === currentUser._id.toString()
                            a.btn.btn-primary.btn-sm.tweet-action-btn.me-1(href=`/tweets/${tweet._id}`)
                                i.bi.bi-pencil
                            a.btn.btn-danger.btn-sm.tweet-action-btn(href=`/tweets/delete/${tweet._id}`)
                                i.bi.bi-trash
