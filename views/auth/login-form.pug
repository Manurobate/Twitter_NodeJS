extends ../layout

block content
    .d-flex.flex-row.content.justify-content-center.mx-auto
        form.card(method="post" action="/auth/login")
            .card-header Inscription
            .card-body
                .form-group
                    label Email *
                    input.form-control(type="email" name="email" required)
                .form-group
                    label Mot de passe *
                    input.form-control(type="password" name="password" required)
                .w-100
                    input.btn.btn-primary.ml-auto.float-right(type="submit" value="Connexion")
    if errors
        .alert.alert-danger.mt-3.w-50.mx-auto(role="alert")
            each error in errors
                div= error
